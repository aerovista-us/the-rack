{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://therack.aerovista.us/prototype/publication.schema.json",
  "title": "Vespera Publication Manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "title",
    "pages"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "series": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "string"
    },
    "creator": {
      "type": "string"
    },
    "format": {
      "type": "object",
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "readingDirection": {
          "enum": [
            "ltr",
            "rtl"
          ]
        }
      },
      "additionalProperties": true
    },
    "physical": {
      "type": "object",
      "properties": {
        "binding": {
          "type": "string"
        },
        "cover": {
          "type": "string"
        },
        "paper": {
          "type": "object",
          "properties": {
            "profile": {
              "type": "string"
            },
            "color": {
              "type": "string"
            },
            "edgeColor": {
              "type": "string"
            },
            "textureOpacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.5
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "pages": {
      "type": "array",
      "minItems": 2,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "type",
              "src"
            ],
            "properties": {
              "type": {
                "const": "image"
              },
              "src": {
                "type": "string",
                "minLength": 1
              },
              "alt": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "hard": {
                "type": "boolean"
              },
              "hideLabel": {
                "type": "boolean"
              },
              "fit": {
                "enum": [
                  "cover",
                  "contain"
                ]
              },
              "position": {
                "type": "string",
                "minLength": 1
              },
              "edgeFill": {
                "enum": [
                  "none",
                  "soft"
                ]
              }
            },
            "additionalProperties": true
          },
          {
            "type": "object",
            "required": [
              "type",
              "html"
            ],
            "properties": {
              "type": {
                "const": "html"
              },
              "html": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "hard": {
                "type": "boolean"
              },
              "hideLabel": {
                "type": "boolean"
              }
            },
            "additionalProperties": true
          }
        ]
      }
    }
  },
  "additionalProperties": true
}
